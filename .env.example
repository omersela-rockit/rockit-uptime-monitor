# --- Server ---
PORT=3000
# Random long random string used to sign the login session cookie. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-random-string

# --- Login (this app has a single admin user) ---
ADMIN_USERNAME=admin
# Generate a bcrypt hash for your password with:
# node -e "console.log(require('bcryptjs').hashSync('YOUR_PASSWORD_HERE', 10))"
ADMIN_PASSWORD_HASH=

# --- Sign in with Google (optional, adds a "Sign in with Google" button alongside the username/password login) ---
# 1. https://console.cloud.google.com/apis/credentials -> Create Credentials -> OAuth client ID -> "Web application"
# 2. Authorized redirect URI: http://localhost:3000/auth/google/callback (or https://yourdomain/auth/google/callback in production)
# 3. Copy the Client ID and Client Secret below
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
# Only this exact Google account is allowed to sign in this way
ALLOWED_GOOGLE_EMAIL=your-gmail-address@gmail.com

# --- Email (Gmail SMTP with an App Password) ---
# 1. Turn on 2-Step Verification: https://myaccount.google.com/signinoptions/two-step-verification
# 2. Create an App Password: https://myaccount.google.com/apppasswords
#    (choose app "Mail", device "Other", name it "uptime-monitor") -> copy the 16-character password
GMAIL_USER=your-gmail-address@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Where alerts & summaries are sent (usually the same as GMAIL_USER)
ALERT_EMAIL_TO=your-gmail-address@gmail.com

# --- Monitoring ---
# How many consecutive failed checks before a site is marked DOWN and an alert is sent
# (1 = alert immediately on the first failed check)
FAILURE_THRESHOLD=2
# Default check interval for new sites, in seconds
DEFAULT_CHECK_INTERVAL_SECONDS=300
# Request timeout per check, in ms
CHECK_TIMEOUT_MS=15000
# A site that responds slower than this (ms) gets flagged as "slow" on its check history (does not trigger a down alert)
SLOW_RESPONSE_MS=8000
# Max number of sites checked in parallel. Keep this modest -- checking too many sites at once
# floods the local connection/DNS resolver and causes false "timed out" results.
CHECK_CONCURRENCY=6

# --- Periodic summary email ---
# "daily", "weekly", or "off"
SUMMARY_FREQUENCY=daily
# Hour of day (0-23, server local time) the summary is sent
SUMMARY_HOUR=8
